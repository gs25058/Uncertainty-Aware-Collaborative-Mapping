{
  "name": "d455_inspired_optimistic",
  "description": "Optimistic virtual depth observations inspired by public D455-class specifications, not a device reproduction",
  "nominal_sensor_resolution": [1280, 720], "nominal_sensor_mode_fps": 30,
  "hardware_max_fps_other_modes": 90, "hardware_high_speed_example_resolution": [848, 480],
  "sample_width": 320, "sample_height": 180,
  "baseline_m": 0.095, "horizontal_fov_deg": 87.0, "vertical_fov_deg": 58.0,
  "z_min_m": 0.6, "z_max_m": 6.0, "integration_hz": 4,
  "range_convention": "optical_Z; actual ray length is used for smoke integration and map ray caps",
  "sigma_constant_m": 0.002, "sigma_quadratic_per_m": 0.001,
  "drone_bias_std_m": 0.001, "drop_probability": 0.005, "outlier_probability": 0.0005,
  "outlier_min_m": 0.05, "outlier_max_m": 0.20,
  "edge_absolute_threshold_m": 0.10, "edge_relative_threshold": 0.05, "edge_dilation_pixels": 1,
  "grazing_start_deg": 75.0, "grazing_full_deg": 88.0,
  "geometry_sigma_increase": 0.5, "geometry_drop_increase": 0.02,
  "correlation_spacing_m": 0.15, "correlation_time_s": 0.75,
  "noise_variance_weights": [0.25, 0.55, 0.20],
  "patch_variance_weights": [0.35, 0.45, 0.20],
  "binocular_visibility": true, "right_visibility_tolerance_m": 0.0002,
  "smoke_beta_per_m": 0.4,
  "degradation": {
    "clean": {"k": 0.0, "a": 0.0, "q": 0.0},
    "weak": {"k": 0.5, "a": 0.02, "q": 0.0005},
    "medium": {"k": 1.5, "a": 0.08, "q": 0.002},
    "strong": {"k": 3.0, "a": 0.20, "q": 0.005}
  },
  "public_sigma": "observed-Z sigma with maximum geometry and configured degradation factors plus known outlier mixture variance and bias variance; no true error/T/normal/outlier flag",
  "sources": [
    "https://www.realsenseai.com/product-family/450-series/",
    "https://support.realsenseai.com/hc/en-us/articles/360059129453-Depth-accuracy-for-Intel-RealSense-D400-Series-Cameras",
    "https://dev.realsenseai.com/docs/tuning-depth-cameras-for-best-performance/",
    "https://realsenseai.com/wp-content/uploads/2025/08/Intel-RealSense-D400-Series-Datasheet-August-2025.pdf"
  ]
}
