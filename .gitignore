# ---- large / machine-specific binaries (not project code) ----
code
vscode_cli.tar.gz
*.tar.gz

# ---- compiled driver binary (keep the .cc source) ----
orbslam_driver/mono_miluv

# ---- private session transcripts & copyrighted reference material ----
# Ignore the CONTENTS (24 MB of copyrighted PDFs + private transcripts) but keep
# RESULTS_SUMMARY.md tracked: PREREG_RESOLUTION.md §3 cites its appendix B as the
# frozen-parameter source, so it has to be versioned. A parent dir cannot be
# un-ignored per-file, hence "dir/*" rather than "dir/".
reference files/*
!reference files/RESULTS_SUMMARY.md
*-reference-files*.txt
*-covor-slam-*.txt
*-handoffmd.txt
*-this-session-*.txt
과거_세션_대화_기록.txt
untitled.txt

# ---- local tooling / editor state ----
.claude/
.ipynb_checkpoints/
__pycache__/
*.pyc

# ---- regeneratable / bulky VO artifacts ----
# image lists hold absolute machine paths and are regenerated by prep_vo.py
vo_output/*_list.txt
vo_output/*.log
vo_output/smoke_*
vo_output/vo_*.log

# ---- regeneratable occupancy inputs (fused poses + Sigma; make with fuse_and_dump.py) ----
vo_output/occ_*.npz

# ---- research byproducts (kept locally, not part of the code) ----
DIAGNOSIS.md
*_results.csv
results/
scripts/diagnose.py
scripts/diagnose_data.py
scripts/diag.py
scripts/compare_lc.py
scripts/test1_alignment.py
scripts/test2_aux.py
scripts/test2_gtrange.py
scripts/summarize_sweep.py
scripts/summarize_height.py
scripts/eval_seq.py

# ---- secrets / credentials (NEVER commit) ----
ssh_key
ssh_key.pub
*.pem
id_rsa
id_ed25519

# ---- OS cruft ----
.DS_Store

# ---- regenerated viewer payload (1 MB of base64 voxels; rebuild with
